\ProvidesFile{sist02.cbx}[2026/05/21 v5.0 biblatex citation style for SIST02 (Strict Numeric Comp)]

% ==============================================================================
% SIST 02 準拠 biblatex 引用スタイルファイル (Citation Style)
% ==============================================================================

\RequireCitationStyle{numeric-comp}

% ------------------------------------------------------------------------------
% 1. オプション設定 (複数参照時のソート強制)
% ------------------------------------------------------------------------------
\ExecuteBibliographyOptions{sortcites=true}

% ------------------------------------------------------------------------------
% 2. 句読点と区切り文字の設定
% ------------------------------------------------------------------------------
% 連続する番号を省略する際の記号をエンダッシュ (–) に設定
\renewcommand*{\bibrangedash}{\textendash}

% 複数の文献番号の区切りをカンマとスペースに設定
\renewcommand*{\multicitedelim}{\addcomma\space}

% ------------------------------------------------------------------------------
% 3. 引用フォーマットの再定義 (角括弧ごと上付き文字にする)
% ------------------------------------------------------------------------------
\newcommand*{\mkbibsuperbrackets}[1]{\textsuperscript{\mkbibbrackets{#1}}}

% ------------------------------------------------------------------------------
% 4. 引用記号の改行禁止と上付き [1] 化
% ------------------------------------------------------------------------------
\newcommand*{\mkbibsuperbracketsnobreak}[1]{\unskip\nobreak\mkbibsuperbrackets{#1}}

\DeclareCiteCommand{\cite}[\mkbibsuperbracketsnobreak]
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{cite:comp}}
  {}
  {\usebibmacro{cite:dump}%
   \usebibmacro{postnote}}

\DeclareCiteCommand{\parencite}[\mkbibsuperbracketsnobreak]
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{cite:comp}}
  {}
  {\usebibmacro{cite:dump}%
   \usebibmacro{postnote}}

\endinput
