\ProvidesFile{sist02.bbx}[2026/11/27 v10.1 biblatex bibliography style for SIST02 (Strict Full Compliance)]

% ==============================================================================
% SIST 02-2007 (科学技術情報流通技術基準: 参照文献の書き方) 完全記述準拠
% biblatex 文献一覧スタイルファイル (Bibliography Style)
% ==============================================================================

\RequireBibliographyStyle{numeric}

% ------------------------------------------------------------------------------
% 1. 全般的なオプション設定および独自オプション
% ------------------------------------------------------------------------------
\ExecuteBibliographyOptions{
  giveninits=false,
  useprefix=true,
  maxnames=999,
  minnames=999,
  sorting=none,
  date=iso,
  urldate=iso,
  eventdate=iso,
  updatedate=iso,
  seconds=true,
  isbn=true,
  doi=true,
  eprint=true
}

% 入手日付ラベルの既定値切替オプション:
%   urldatelabel=accessed (既定: 和文「参照」、欧文「accessed」)
%   urldatelabel=cited    (和文「入手」、欧文「cited」)
\newcommand*{\sist@urldatelabelopt}{accessed}
\DeclareBibliographyOption[string]{urldatelabel}{%
  \def\sist@urldatelabelopt{#1}%
}

% ------------------------------------------------------------------------------
% 2. 言語・文字種判定 (expl3 による Unicode 判定とトグル管理)
% ------------------------------------------------------------------------------
\newtoggle{isjapanese}
\newcommand*{\sist@currnamewestern}{0}
\newcommand*{\sist@prevnamewestern}{0}
\newcommand*{\sist@listwestern}{0}
\newtoggle{sist@printednote}

\ExplSyntaxOn
% 先頭が数字（オプションで空白前置）かどうか（ASCII のみのため全エンジン共通）
\regex_const:Nn \c_sist_digit_regex
  { \A\s*[0-9] }

% エンジン分岐による日本語文字種判定 (lualatex/xelatex は Unicode l3regex、
% uplatex/platex は内部文字コード判定、pdflatex 等 8bit エンジンは UTF-8 バイト列判定)
\bool_lazy_or:nnTF { \sys_if_engine_luatex_p: } { \sys_if_engine_xetex_p: }
  {
    % 漢字・平仮名・踊り字（和文人名の自動判定用：カタカナのみの外国人名を除外）
    \regex_const:Nn \c_sist_kanji_hira_regex
      { [\x{3040}-\x{309F}\x{4E00}-\x{9FFF}\x{3400}-\x{4DBF}\x{F900}-\x{FAFF}\x{3005}] }

    % 漢字・平仮名・片仮名（文献本文の和文/欧文判定用）
    \regex_const:Nn \c_sist_jp_any_regex
      { [\x{3040}-\x{309F}\x{30A0}-\x{30FF}\x{4E00}-\x{9FFF}\x{3400}-\x{4DBF}\x{F900}-\x{FAFF}\x{3005}] }

    % 1段階展開 (\tl_set:No) によりアクセント記号 (\"o 等) を安全に保持したまま正規表現判定
    \cs_new_protected:Npn \sist_if_jp_any:nTF #1#2#3
      {
        \tl_set:No \l_tmpa_tl {#1}
        \regex_match:NVTF \c_sist_jp_any_regex \l_tmpa_tl {#2} {#3}
      }

    \cs_new_protected:Npn \sist_if_kanji_hira:nTF #1#2#3
      {
        \tl_set:No \l_tmpa_tl {#1}
        \regex_match:NVTF \c_sist_kanji_hira_regex \l_tmpa_tl {#2} {#3}
      }
  }
  {
    \bool_set_false:N \l_tmpa_bool
    \bool_set_false:N \l_tmpb_bool
    \int_new:N \l_sist_utf_state_int
    \bool_lazy_or:nnTF { \sys_if_engine_ptex_p: } { \sys_if_engine_uptex_p: }
      {
        \int_compare:nNnTF { `あ } = { 12354 }
          {
            % upLaTeX (内部文字コードが Unicode)
            \cs_new_protected:Npn \sist_uptex_has_range:nNTF #1#2#3#4
              {
                \tl_set:No \l_tmpa_tl {#1}
                \bool_set_false:N \l_tmpa_bool
                \tl_analysis_map_inline:Nn \l_tmpa_tl
                  {
                    \bool_lazy_or:nnT
                      {
                        \bool_lazy_or_p:nn
                          { \int_compare_p:n { ##2 = "3005 } }
                          {
                            \bool_lazy_and_p:nn
                              { \int_compare_p:n { ##2 >= "3040 } }
                              { \int_compare_p:n { ##2 <= #2 } }
                          }
                      }
                      {
                        \bool_lazy_or_p:nn
                          {
                            \bool_lazy_and_p:nn
                              { \int_compare_p:n { ##2 >= "3400 } }
                              { \int_compare_p:n { ##2 <= "4DBF } }
                          }
                          {
                            \bool_lazy_or_p:nn
                              {
                                \bool_lazy_and_p:nn
                                  { \int_compare_p:n { ##2 >= "4E00 } }
                                  { \int_compare_p:n { ##2 <= "9FFF } }
                              }
                              {
                                \bool_lazy_and_p:nn
                                  { \int_compare_p:n { ##2 >= "F900 } }
                                  { \int_compare_p:n { ##2 <= "FAFF } }
                              }
                          }
                      }
                      { \bool_set_true:N \l_tmpa_bool \tl_map_break: }
                  }
                \bool_if:NTF \l_tmpa_bool {#3} {#4}
              }

            \cs_new_protected:Npn \sist_if_jp_any:nTF #1#2#3
              { \sist_uptex_has_range:nNTF {#1} { "30FF } {#2} {#3} }

            \cs_new_protected:Npn \sist_if_kanji_hira:nTF #1#2#3
              { \sist_uptex_has_range:nNTF {#1} { "309F } {#2} {#3} }
          }
          {
            % pLaTeX (互換モード：内部文字コード > 255、かつ Shift_JIS/EUC/JIS 共通順を利用)
            \int_const:Nn \c_sist_ptex_odoriji_int { `々 }
            \int_const:Nn \c_sist_ptex_hira_min_int { `ぁ }
            \int_const:Nn \c_sist_ptex_hira_max_int { `ん }
            \int_const:Nn \c_sist_ptex_kana_max_int { `ヶ }

            \cs_new_protected:Npn \sist_if_jp_any:nTF #1#2#3
              {
                \tl_set:No \l_tmpa_tl {#1}
                \bool_set_false:N \l_tmpa_bool
                \tl_analysis_map_inline:Nn \l_tmpa_tl
                  {
                    \int_compare:nNnT { ##2 } > { 255 }
                      { \bool_set_true:N \l_tmpa_bool \tl_map_break: }
                  }
                \bool_if:NTF \l_tmpa_bool {#2} {#3}
              }

            \cs_new_protected:Npn \sist_if_kanji_hira:nTF #1#2#3
              {
                \tl_set:No \l_tmpa_tl {#1}
                \bool_set_false:N \l_tmpa_bool
                \tl_analysis_map_inline:Nn \l_tmpa_tl
                  {
                    \int_compare:nNnT { ##2 } > { 255 }
                      {
                        \bool_lazy_or:nnT
                          {
                            \bool_lazy_or_p:nn
                              { \int_compare_p:nNn { ##2 } = { \c_sist_ptex_odoriji_int } }
                              { \int_compare_p:nNn { ##2 } > { \c_sist_ptex_kana_max_int } }
                          }
                          {
                            \bool_lazy_and_p:nn
                              { \int_compare_p:n { ##2 >= \c_sist_ptex_hira_min_int } }
                              { \int_compare_p:n { ##2 <= \c_sist_ptex_hira_max_int } }
                          }
                          { \bool_set_true:N \l_tmpa_bool \tl_map_break: }
                      }
                  }
                \bool_if:NTF \l_tmpa_bool {#2} {#3}
              }
          }
      }
      {
        % pdfLaTeX 等の 8bit エンジン向け UTF-8 バイト列検査
        % state: 0=初期, 1=0xE3直後, 2=0xE3+0x80(記号・々), 3=0xE3+0x82(平仮名後半/片仮名前半), 4=0xE4..0xE9(漢字1byte目), 5=0xE4..0xE9の2byte目確認後
        \cs_new_protected:Npn \sist_scan_utf8_jp:n #1
          {
            \tl_set:No \l_tmpa_tl {#1}
            \bool_set_false:N \l_tmpa_bool % jp_any
            \bool_set_false:N \l_tmpb_bool % kanji_hira
            \int_zero:N \l_sist_utf_state_int
            \tl_analysis_map_inline:Nn \l_tmpa_tl
              {
                \int_compare:nNnT { ##2 } > { -1 }
                  {
                    \int_case:nnF { \l_sist_utf_state_int }
                      {
                        { 1 }
                          {
                            \int_compare:nNnTF { ##2 } = { 128 }
                              { \int_set:Nn \l_sist_utf_state_int { 2 } }
                              {
                                \int_compare:nNnTF { ##2 } = { 129 }
                                  { \bool_set_true:N \l_tmpa_bool \bool_set_true:N \l_tmpb_bool \int_zero:N \l_sist_utf_state_int }
                                  {
                                    \int_compare:nNnTF { ##2 } = { 130 }
                                      { \int_set:Nn \l_sist_utf_state_int { 3 } }
                                      {
                                        \int_compare:nNnT { ##2 } = { 131 }
                                          { \bool_set_true:N \l_tmpa_bool }
                                        \int_zero:N \l_sist_utf_state_int
                                      }
                                  }
                              }
                          }
                        { 2 }
                          {
                            \int_compare:nNnT { ##2 } = { 133 }
                              { \bool_set_true:N \l_tmpa_bool \bool_set_true:N \l_tmpb_bool }
                            \int_zero:N \l_sist_utf_state_int
                          }
                        { 3 }
                          {
                            \bool_lazy_and:nnT { \int_compare_p:n { ##2 >= 128 } } { \int_compare_p:n { ##2 <= 191 } }
                              {
                                \bool_set_true:N \l_tmpa_bool
                                \int_compare:nNnT { ##2 } < { 160 }
                                  { \bool_set_true:N \l_tmpb_bool }
                              }
                            \int_zero:N \l_sist_utf_state_int
                          }
                        { 4 }
                          {
                            \bool_lazy_and:nnTF { \int_compare_p:n { ##2 >= 128 } } { \int_compare_p:n { ##2 <= 191 } }
                              { \int_set:Nn \l_sist_utf_state_int { 5 } }
                              { \int_zero:N \l_sist_utf_state_int }
                          }
                        { 5 }
                          {
                            \bool_lazy_and:nnT { \int_compare_p:n { ##2 >= 128 } } { \int_compare_p:n { ##2 <= 191 } }
                              { \bool_set_true:N \l_tmpa_bool \bool_set_true:N \l_tmpb_bool }
                            \int_zero:N \l_sist_utf_state_int
                          }
                      }
                      {
                        \int_compare:nNnTF { ##2 } = { 227 }
                          { \int_set:Nn \l_sist_utf_state_int { 1 } }
                          {
                            \bool_lazy_and:nnT { \int_compare_p:n { ##2 >= 228 } } { \int_compare_p:n { ##2 <= 233 } }
                              { \int_set:Nn \l_sist_utf_state_int { 4 } }
                          }
                      }
                  }
              }
          }

        \cs_new_protected:Npn \sist_if_jp_any:nTF #1#2#3
          {
            \sist_scan_utf8_jp:n {#1}
            \bool_if:NTF \l_tmpa_bool {#2} {#3}
          }

        \cs_new_protected:Npn \sist_if_kanji_hira:nTF #1#2#3
          {
            \sist_scan_utf8_jp:n {#1}
            \bool_if:NTF \l_tmpb_bool {#2} {#3}
          }
      }
  }

\cs_new_protected:Npn \sist_if_starts_with_digit:nTF #1#2#3
  {
    \tl_set:No \l_tmpa_tl {#1}
    \regex_match:NVTF \c_sist_digit_regex \l_tmpa_tl {#2} {#3}
  }

\cs_new_protected:Npn \sist_if_contains_str:nnTF #1#2#3#4
  {
    \tl_set:No \l_tmpa_tl {#1}
    \exp_args:NV \tl_if_in:nnTF \l_tmpa_tl {#2} {#3} {#4}
  }

\cs_new_protected:Npn \sist_if_case_eq:nnTF #1#2#3#4
  {
    \tl_set:No \l_tmpa_tl {#1}
    \tl_set:No \l_tmpb_tl {#2}
    \str_if_eq:eeTF
      { \exp_args:NV \str_lowercase:n \l_tmpa_tl }
      { \exp_args:NV \str_lowercase:n \l_tmpb_tl }
      {#3} {#4}
  }

\cs_new_eq:NN \sist@ifjpany \sist_if_jp_any:nTF
\cs_new_eq:NN \sist@ifkanjihira \sist_if_kanji_hira:nTF
\cs_new_eq:NN \sist@ifstartswithdigit \sist_if_starts_with_digit:nTF
\cs_new_eq:NN \sist@ifcontains \sist_if_contains_str:nnTF
\cs_new_eq:NN \sist@ifcaseeq \sist_if_case_eq:nnTF
\ExplSyntaxOff

\newcommand*{\sist@detectentrylang}{%
  \settoggle{isjapanese}{false}%
  \iffieldundef{langid}
    {\def\sist@langprobe{}%
     \iffieldundef{title}
       {\iffieldundef{booktitle}
          {\iffieldundef{journaltitle}
             {\iffieldundef{maintitle}
                {}
                {\savefield{maintitle}{\sist@langprobe}}}
             {\savefield{journaltitle}{\sist@langprobe}}}
          {\savefield{booktitle}{\sist@langprobe}}}
       {\savefield{title}{\sist@langprobe}}%
     \ifdefempty{\sist@langprobe}
       {\iflistundef{language}
          {\settoggle{isjapanese}{true}}
          {\ifboolexpr{
             test {\iflistcontains{language}{japanese}} or
             test {\iflistcontains{language}{Japanese}} or
             test {\iflistcontains{language}{ja}}
           }{\settoggle{isjapanese}{true}}{}}}
       {\sist@ifjpany{\sist@langprobe}
          {\settoggle{isjapanese}{true}}
          {\settoggle{isjapanese}{false}}}}
    {\ifboolexpr{
       test {\iffieldequalstr{langid}{japanese}} or
       test {\iffieldequalstr{langid}{ja}}
     }{\settoggle{isjapanese}{true}}{}}%
}

\AtEveryBibitem{%
  \sist@detectentrylang
  \gdef\sist@currnamewestern{0}%
  \gdef\sist@prevnamewestern{0}%
  \gdef\sist@listwestern{0}%
  \togglefalse{sist@printednote}%
}

% ------------------------------------------------------------------------------
% 3. 句読点と区切り文字の設定 (SIST 02 3.3.6 表1)
% ------------------------------------------------------------------------------
\renewcommand*{\labelnamepunct}{\addperiod\space}
\renewcommand*{\newunitpunct}{\addperiod\space}
\renewcommand*{\subtitlepunct}{\addcolon\space}
\renewcommand*{\bibdaterangesep}{-}

\DeclareDelimFormat{multinamedelim}{%
  \ifboolexpr{
    not togl {isjapanese} or
    test {\ifdefstring{\sist@prevnamewestern}{1}} or
    test {\ifdefstring{\sist@currnamewestern}{1}}
  }{\printtext{;\space}}{\printtext{,\space}}%
}
\DeclareDelimFormat{finalnamedelim}{%
  \ifboolexpr{
    not togl {isjapanese} or
    test {\ifdefstring{\sist@prevnamewestern}{1}} or
    test {\ifdefstring{\sist@currnamewestern}{1}}
  }{\printtext{;\space}}{\printtext{,\space}}%
}
\DeclareDelimFormat{andothersdelim}{}

% ------------------------------------------------------------------------------
% 4. 著者・編者・訳者名のフォーマット (SIST 02 4.1.1, 4.1.2, 4.1.4)
% ------------------------------------------------------------------------------
% 各人名ごとに:
%   1) Biber アノテーション (author+an = {1=western; 2=japanese; 3=literal})
%   2) エントリ単位指定 (authorstyle = {japanese|western})
%   3) given が空の場合は単一名/団体名/ハンドル名としてコンマ無し出力
%   4) 自動判定: 漢字または平仮名を含む -> 和文人名 (姓 名 スペース無し)
%                 漢字・平仮名を含まない (欧文・カタカナ外国人名) -> 欧文人名 (姓, 名)
\DeclareNameFormat{family-given}{%
  \ifnumequal{\value{listcount}}{1}
    {\gdef\sist@prevnamewestern{0}%
     \gdef\sist@listwestern{0}}
    {\ifdefstring{\sist@currnamewestern}{1}
       {\gdef\sist@prevnamewestern{1}}
       {\gdef\sist@prevnamewestern{0}}}%
  \gdef\sist@currnamewestern{0}%
  \def\sist@namemode{auto}%
  \ifitemannotation{japanese}{\def\sist@namemode{japanese}}{}%
  \ifitemannotation{western}{\def\sist@namemode{western}}{}%
  \ifitemannotation{foreign}{\def\sist@namemode{western}}{}%
  \ifitemannotation{katakana}{\def\sist@namemode{western}}{}%
  \ifitemannotation{literal}{\def\sist@namemode{literal}}{}%
  \ifdefstring{\sist@namemode}{auto}
    {\iffieldequalstr{authorstyle}{japanese}
       {\def\sist@namemode{japanese}}
       {\iffieldequalstr{authorstyle}{western}
          {\def\sist@namemode{western}}
          {}}}
    {}%
  \ifdefstring{\sist@namemode}{auto}
    {\ifdefvoid{\namepartgiven}
       {\def\sist@namemode{literal}}
       {\ifdefvoid{\namepartfamily}
          {\def\sist@namemode{literal}}
          {\sist@ifkanjihira{\namepartfamily}
             {\def\sist@namemode{japanese}}
             {\sist@ifkanjihira{\namepartgiven}
                {\def\sist@namemode{japanese}}
                {\def\sist@namemode{western}}}}}}
    {}%
  \ifdefstring{\sist@namemode}{western}
    {\gdef\sist@currnamewestern{1}%
     \gdef\sist@listwestern{1}}
    {}%
  \usebibmacro{name:delim}{#1}%
  \usebibmacro{name:hook}{#1}%
  \ifdefstring{\sist@namemode}{literal}
    {\ifdefvoid{\namepartprefix}{}{\namepartprefix\addspace}%
     \namepartfamily
     \ifdefvoid{\namepartsuffix}{}{\addcomma\space\namepartsuffix}%
     \ifdefvoid{\namepartgiven}{}{\addspace\namepartgiven}}
    {\ifdefstring{\sist@namemode}{japanese}
       {\namepartfamily\namepartgiven
        \ifdefvoid{\namepartsuffix}{}{\addspace\namepartsuffix}}
       {\ifuseprefix
          {\ifdefvoid{\namepartprefix}{}{\namepartprefix\addspace}%
           \namepartfamily
           \ifdefvoid{\namepartsuffix}{}{\addcomma\space\namepartsuffix}%
           \ifdefvoid{\namepartgiven}{}{\addcomma\space\namepartgiven}}
          {\namepartfamily
           \ifdefvoid{\namepartsuffix}{}{\addcomma\space\namepartsuffix}%
           \ifdefvoid{\namepartgiven}{}{\addcomma\space\namepartgiven}%
           \ifdefvoid{\namepartprefix}{}{\addspace\namepartprefix}}}}%
  \usebibmacro{name:andothers}%
}

\DeclareNameAlias{author}{family-given}
\DeclareNameAlias{editor}{family-given}
\DeclareNameAlias{translator}{family-given}
\DeclareNameAlias{holder}{family-given}
\DeclareNameAlias{bookauthor}{family-given}
\DeclareNameAlias{namea}{family-given}

\renewbibmacro*{name:andothers}{%
  \ifboolexpr{
    test {\ifnumequal{\value{listcount}}{\value{liststop}}}
    and
    test \ifmorenames
  }
    {\ifboolexpr{
       togl {isjapanese} and not test {\ifdefstring{\sist@currnamewestern}{1}}
     }
       {\printtext{ほか}}
       {\addspace\printtext{et\addspace al\adddot}}}
    {}%
}

% ------------------------------------------------------------------------------
% 5. フィールドフォーマットの再定義
% ------------------------------------------------------------------------------
\DeclareFieldFormat{title}{#1}
\DeclareFieldFormat{sistquotedtitle}{``#1''\@}
\DeclareFieldFormat[article,book,mvbook,collection,mvcollection,proceedings,mvproceedings,periodical,reference,mvreference,booklet,thesis,patent,standard,unpublished,video,audio,artwork,misc,legislation,dataset,software]{title}{#1}
\DeclareFieldFormat[inbook,bookinbook,suppbook,incollection,suppcollection,inreference,inproceedings,conference,online,letter]{title}{``#1''\@}

\DeclareFieldFormat{issuetitle}{#1}
\DeclareFieldFormat{subtitle}{#1}
\DeclareFieldFormat{booktitle}{#1}
\DeclareFieldFormat{booksubtitle}{#1}
\DeclareFieldFormat{journaltitle}{#1}
\DeclareFieldFormat{journalsubtitle}{#1}
\DeclareFieldFormat{maintitle}{#1}
\DeclareFieldFormat{mainsubtitle}{#1}
\DeclareFieldFormat{eventtitle}{#1}
\DeclareFieldFormat{venue}{#1}

% 巻・号・分冊・特集号・ページ
\DeclareFieldFormat{volume}{vol\adddot\space#1}
\DeclareFieldFormat[article,periodical,suppperiodical]{volume}{vol\adddot\space#1}
\DeclareFieldFormat{number}{#1}
\DeclareFieldFormat[article,periodical,suppperiodical]{number}{no\adddot\space#1}
\DeclareFieldFormat{articlenumber}{no\adddot\space#1}
\DeclareFieldFormat{seriesnumber}{#1}
\DeclareFieldFormat{part}{\ifinteger{#1}{pt\adddot\space#1}{#1}}
\DeclareFieldFormat{issue}{#1}
\DeclareFieldFormat{pages}{{\def\bibrangedash{-}p\adddot\space#1}}
\DeclareFieldFormat{pagetotal}{#1p\adddot}
\DeclareFieldFormat{volumes}{%
  \iftoggle{isjapanese}{#1冊}{#1\space vols\adddot}%
}
\DeclareFieldFormat{eid}{#1}

% 識別子・URL・入手日付
\DeclareFieldFormat{doi}{doi\addcolon\nolinkurl{#1}}
\DeclareFieldFormat{isbn}{ISBN\space#1}
\DeclareFieldFormat{issn}{ISSN\space#1}
\DeclareFieldFormat{isrn}{#1}
\DeclareFieldFormat{url}{\url{#1}}

\DeclareFieldFormat{edition}{%
  \iffieldequalstr{editionliteral}{true}
    {#1}
    {\ifstrequal{#1}{1}
       {}
       {\ifinteger{#1}
          {\iftoggle{isjapanese}{第#1版}{\mkbibordinal{#1}\space ed\adddot}}
          {#1}}}%
}

\DeclareFieldFormat{version}{%
  \sist@ifstartswithdigit{#1}{Version\space#1}{#1}%
}

\DeclareFieldFormat{commit}{commit\space#1}

\DeclareFieldFormat[thesis]{type}{%
  \iftoggle{isjapanese}
    {\ifboolexpr{ test {\iffieldequalstr{type}{phdthesis}} }
       {博士論文}
       {\ifboolexpr{ test {\iffieldequalstr{type}{mathesis}} }
          {修士論文}
          {#1}}}
    {\ifboolexpr{ test {\iffieldequalstr{type}{phdthesis}} }
       {Ph.D. thesis}
       {\ifboolexpr{ test {\iffieldequalstr{type}{mathesis}} }
          {Master's thesis}
          {#1}}}%
}

% ------------------------------------------------------------------------------
% 6. マクロの再定義 (SIST 02 各書誌要素)
% ------------------------------------------------------------------------------
\renewbibmacro*{in:}{}

% 標題 + 副標題 (SIST 02 4.2.1, 4.2.3: コロン区切り)
\renewbibmacro*{title}{%
  \ifboolexpr{
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
    and
    test {\iffieldundef{issuetitle}}
  }
    {}
    {\iffieldundef{issuetitle}
       {}
       {\printfield{issuetitle}\setunit{\addcolon\space}}%
     \printtext[title]{%
       \printfield[titlecase]{title}%
       \setunit{\subtitlepunct}%
       \printfield[titlecase]{subtitle}}%
     \newunit}%
}

% レポート中1論文・データベース一部・ソースファイル用の引用符付き標題マクロ
\newbibmacro*{sist:quotedtitle}{%
  \ifboolexpr{
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
  }
    {}
    {\printtext[sistquotedtitle]{%
       \printfield[titlecase]{title}%
       \setunit{\subtitlepunct}%
       \printfield[titlecase]{subtitle}}%
     \newunit}%
}

\newbibmacro*{sist:booktitle}{%
  \ifboolexpr{
    test {\iffieldundef{booktitle}}
    and
    test {\iffieldundef{booksubtitle}}
  }
    {}
    {\printfield{booktitle}%
     \setunit{\subtitlepunct}%
     \printfield{booksubtitle}}%
}

\renewbibmacro*{journal}{%
  \ifboolexpr{
    test {\iffieldundef{journaltitle}}
    and
    test {\iffieldundef{journalsubtitle}}
  }
    {}
    {\printfield{journaltitle}%
     \setunit{\addcomma\space}%
     \printfield{journalsubtitle}}%
}

% 編者・翻訳者・特許出願人 (SIST 02 4.1.4, 4.1.5)
\renewbibmacro*{editorstrg}{%
  \ifboolexpr{ not togl {isjapanese} or test {\ifdefstring{\sist@listwestern}{1}} }
    {\ifboolexpr{ test {\ifnumgreater{\value{editor}}{1}} or test {\ifandothers{editor}} }
       {\printtext{eds\adddot}}
       {\printtext{ed\adddot}}}
    {\printtext{編}}%
}

\renewbibmacro*{editor}{%
  \ifnameundef{editor}
    {}
    {\gdef\sist@listwestern{0}%
     \printnames{editor}%
     \ifboolexpr{ not togl {isjapanese} or test {\ifdefstring{\sist@listwestern}{1}} }
       {\setunit{\addcomma\space}\usebibmacro{editorstrg}}
       {\setunit{}\usebibmacro{editorstrg}}%
     \clearname{editor}}%
}

\renewbibmacro*{translatorstrg}{%
  \ifboolexpr{ not togl {isjapanese} or test {\ifdefstring{\sist@listwestern}{1}} }
    {\printtext{trans\adddot}}
    {\printtext{訳}}%
}

\renewbibmacro*{translator}{%
  \ifnameundef{translator}
    {}
    {\gdef\sist@listwestern{0}%
     \printnames{translator}%
     \ifboolexpr{ not togl {isjapanese} or test {\ifdefstring{\sist@listwestern}{1}} }
       {\setunit{\addcomma\space}\usebibmacro{translatorstrg}}
       {\setunit{}\usebibmacro{translatorstrg}}%
     \clearname{translator}}%
}

% 著者名・発行年・巻号等
\renewbibmacro*{author}{%
  \ifnameundef{author}
    {}
    {\printnames{author}%
     \clearname{author}}%
}

\newbibmacro*{sist:date}{%
  \iffieldundef{year}
    {}
    {\iffieldundef{endyear}
       {\printdate}
       {\iffieldundef{month}
          {\printfield{year}\bibdaterangesep\printfield{endyear}}
          {\printdate}}}%
}

% 会議開催期間 (SIST 02 4.2.4 / 5.5: 同月なら YYYY-MM-DD/DD, 同年異月なら YYYY-MM-DD/MM-DD)
\newbibmacro*{sist:eventdate}{%
  \iffieldundef{eventyear}
    {}
    {\printfield{eventyear}%
     \iffieldundef{eventmonth}
       {}
       {-\mkmonthzeros{\thefield{eventmonth}}%
        \iffieldundef{eventday}
          {}
          {-\mkdayzeros{\thefield{eventday}}}}%
     \iffieldundef{eventendyear}
       {}
       {\slash
        \ifboolexpr{
          test {\iffieldsequal{eventyear}{eventendyear}}
        }
          {\ifboolexpr{
             test {\iffieldsequal{eventmonth}{eventendmonth}}
           }
             {\mkdayzeros{\thefield{eventendday}}}
             {\mkmonthzeros{\thefield{eventendmonth}}%
              \iffieldundef{eventendday}
                {}
                {-\mkdayzeros{\thefield{eventendday}}}}}
          {\printfield{eventendyear}%
           \iffieldundef{eventendmonth}
             {}
             {-\mkmonthzeros{\thefield{eventendmonth}}%
              \iffieldundef{eventendday}
                {}
                {-\mkdayzeros{\thefield{eventendday}}}}}}}%
}

% 更新日付 (updatedate 優先、なければ date)
\newbibmacro*{sist:updatedate}{%
  \iffieldundef{updateyear}
    {\usebibmacro{sist:date}}
    {\printfield{updateyear}%
     \iffieldundef{updatemonth}
       {}
       {-\mkmonthzeros{\thefield{updatemonth}}%
        \iffieldundef{updateday}
          {}
          {-\mkdayzeros{\thefield{updateday}}}}}%
}

% 4.2.2 (5) 同一誌名区別用の出版地付記 + 巻号 (vol. X, no. Y)
\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \iflistundef{location}
    {}
    {\setunit{\addspace}%
     \printtext[parens]{\printlist{location}}}%
  \setunit{\addperiod\space}%
  \iffieldundef{pubstate}
    {}
    {\ifboolexpr{
       test {\iffieldequalstr{pubstate}{prepublished}} or
       test {\iffieldequalstr{pubstate}{Advance Publication}} or
       test {\iffieldequalstr{pubstate}{早期公開}}
     }
       {\usebibmacro{sist:pubstate}\setunit*{\addcomma\space}}
       {}}%
  \usebibmacro{sist:date}%
  \setunit*{\addcomma\space}%
  \printfield{volume}%
  \setunit*{\addcomma\space}%
  \printfield[articlenumber]{number}%
  \setunit*{\addcomma\space}%
  \printfield{part}%
  \setunit*{\addcomma\space}%
  \printfield{issue}%
  \setunit*{\addcomma\space}%
}

\renewbibmacro*{publisher+location+date}{%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \printlist{publisher}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
}

\renewbibmacro*{event+venue+date}{%
  \printfield{venue}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:eventdate}%
  \setunit*{\addcomma\space}%
  \printlist{organization}%
}

\renewbibmacro*{series+number}{%
  \iffieldundef{series}
    {}
    {\printtext[parens]{%
       \printfield{series}%
       \setunit*{\addcomma\space}%
       \printfield[seriesnumber]{number}%
     }}%
}

% 総ページ数または総冊数 (SIST 02 4.3.12 (5), (6))
\newbibmacro*{sist:pagetotal+volumes}{%
  \iffieldundef{pagetotal}
    {\printfield{volumes}}
    {\printfield{pagetotal}}%
}

% ------------------------------------------------------------------------------
% 7. 注記的な書誌要素マクロ (SIST 02 4.4.1〜4.4.5)
% ------------------------------------------------------------------------------
% 4.4.1 言語の表示 (language / origlanguage は list 型; 原資料の言語と異なる場合のみ出力)
\DeclareListFormat{sistoriglang}{%
  \ifnumequal{\value{listcount}}{1}
    {\def\sist@olang{#1}%
     \ifboolexpr{
       togl {isjapanese} and (
         test {\ifdefstring{\sist@olang}{japanese}} or
         test {\ifdefstring{\sist@olang}{Japanese}} or
         test {\ifdefstring{\sist@olang}{ja}}
       )
     }
       {}
       {\iffieldundef{langid}
          {\ifboolexpr{
             not togl {isjapanese} and (
               test {\ifdefstring{\sist@olang}{english}} or
               test {\ifdefstring{\sist@olang}{English}} or
               test {\ifdefstring{\sist@olang}{en}}
             )
           }
             {}
             {\printtext[parens]{#1}\toggletrue{sist@printednote}}}
          {\savefield{langid}{\sist@lid}%
           \sist@ifcaseeq{\sist@lid}{\sist@olang}
             {}
             {\printtext[parens]{#1}\toggletrue{sist@printednote}}}}}
    {}%
}

\newbibmacro*{sist:origlang}{%
  \iffieldundef{origlangdisplay}
    {\iflistundef{origlanguage}
       {\iflistundef{language}
          {}
          {\printlist[sistoriglang]{language}}}
       {\printlist[sistoriglang]{origlanguage}}}
    {\printtext[parens]{\printfield{origlangdisplay}}\toggletrue{sist@printednote}}%
}

% 4.4.2 投稿中・受理済み・印刷中・早期公開表示
\newbibmacro*{sist:pubstate}{%
  \iffieldundef{pubstate}
    {}
    {\ifboolexpr{ test {\iffieldequalstr{pubstate}{inpress}} }
       {\iftoggle{isjapanese}{\printtext{印刷中}}{\printtext{in press}}}
       {\ifboolexpr{ test {\iffieldequalstr{pubstate}{submitted}} }
          {\iftoggle{isjapanese}{\printtext{投稿中}}{\printtext{submitted}}}
          {\ifboolexpr{ test {\iffieldequalstr{pubstate}{forthcoming}} }
             {\iftoggle{isjapanese}{\printtext{掲載予定}}{\printtext{forthcoming}}}
             {\ifboolexpr{ test {\iffieldequalstr{pubstate}{prepublished}} }
                {\iftoggle{isjapanese}{\printtext{早期公開}}{\printtext{Advance Publication}}}
                {\ifboolexpr{ test {\iffieldequalstr{pubstate}{accepted}} }
                   {\iftoggle{isjapanese}{\printtext{受理済み}}{\printtext{Accepted for publication}}}
                   {\printfield{pubstate}}}}}}}%
}

% 4.4.3 媒体表示
\newbibmacro*{sist:medium}{%
  \iffieldundef{medium}
    {}
    {\printtext[parens]{\printfield{medium}}\toggletrue{sist@printednote}}%
}

% 4.4.5 入手日付 (accesslabel > urldatelabel option > 既定値)
\newbibmacro*{sist:urldate}{%
  \iffieldundef{urlyear}
    {}
    {\printtext[parens]{%
       \iffieldundef{accesslabel}
         {\ifdefstring{\sist@urldatelabelopt}{cited}
            {\iftoggle{isjapanese}{入手}{cited}}
            {\iftoggle{isjapanese}{参照}{accessed}}}
         {\printfield{accesslabel}}%
       \addspace
       \printfield{urlyear}%
       \iffieldundef{urlmonth}
         {}
         {-\mkmonthzeros{\thefield{urlmonth}}%
          \iffieldundef{urlday}
            {}
            {-\mkdayzeros{\thefield{urlday}}}}}%
     \toggletrue{sist@printednote}}%
}

% 4.4.4 入手方法（入手先機関・DB名 + URL）および入手日付
\newbibmacro*{sist:source+url+urldate}{%
  \iffieldundef{availablesource}
    {}
    {\savefield{availablesource}{\sist@srcstr}%
     \iftoggle{isjapanese}
       {\sist@ifcontains{\sist@srcstr}{入手先}
          {\printfield{availablesource}}
          {\printtext{入手先\addcomma\space}\printfield{availablesource}}}
       {\sist@ifcontains{\sist@srcstr}{available from}
          {\printfield{availablesource}}
          {\sist@ifcontains{\sist@srcstr}{Available from}
             {\printfield{availablesource}}
             {\printtext{available from\addspace}\printfield{availablesource}}}}%
     \toggletrue{sist@printednote}}%
  \iffieldundef{url}
    {}
    {\iftoggle{sist@printednote}{\setunit{\addcomma\space}}{}%
     \printfield{url}%
     \toggletrue{sist@printednote}}%
  \iffieldundef{urlyear}
    {}
    {\iftoggle{sist@printednote}{\setunit{\addcomma\space}}{}%
     \usebibmacro{sist:urldate}}%
}

\renewbibmacro*{url+urldate}{%
  \usebibmacro{sist:source+url+urldate}%
}

% 4.4.1〜4.4.5 統合注記ブロック (コンマ区切りで出力し末尾ピリオドで閉じる)
\newbibmacro*{sist:noteelements}{%
  \ifboolexpr{
    not test {\iffieldundef{origlangdisplay}} or
    not test {\iflistundef{origlanguage}} or
    not test {\iflistundef{language}} or
    not test {\iffieldundef{medium}} or
    not test {\iffieldundef{availablesource}} or
    not test {\iffieldundef{url}} or
    not test {\iffieldundef{urlyear}} or
    not test {\iffieldundef{note}}
  }
    {\setunit{\addperiod\space}\newblock
     \togglefalse{sist@printednote}%
     \usebibmacro{sist:origlang}%
     \iffieldundef{medium}
       {}
       {\iftoggle{sist@printednote}{\setunit{\addcomma\space}}{}%
        \usebibmacro{sist:medium}}%
     \ifboolexpr{
       not test {\iffieldundef{availablesource}} or
       not test {\iffieldundef{url}} or
       not test {\iffieldundef{urlyear}}
     }
       {\iftoggle{sist@printednote}{\setunit{\addcomma\space}}{}%
        \usebibmacro{sist:source+url+urldate}}
       {}%
     \iffieldundef{note}
       {}
       {\iftoggle{sist@printednote}{\setunit{\addcomma\space}}{}%
        \printfield{note}%
        \toggletrue{sist@printednote}}}
    {}%
}

% ------------------------------------------------------------------------------
% 8. 資料種類別ドライバ定義 (SIST 02 5.1〜5.13 + BibLoom 全36タイプ対応)
% ------------------------------------------------------------------------------

% 5.1 雑誌 (5.1.1 通常, 5.1.2 特集記事, 5.9 投稿中・早期公開)
\DeclareBibliographyDriver{article}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{journal+issuetitle}%
  \iffieldundef{pages}
    {\printfield{eid}}
    {\printfield{pages}}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \setunit*{\addcomma\space}%
  \printfield{issn}%
  \iffieldundef{pubstate}
    {}
    {\ifboolexpr{
       test {\iffieldequalstr{pubstate}{prepublished}} or
       test {\iffieldequalstr{pubstate}{Advance Publication}} or
       test {\iffieldequalstr{pubstate}{早期公開}}
     }
       {}
       {\setunit{\addperiod\space}\newblock
        \usebibmacro{sist:pubstate}}}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.2.1 図書１冊 (著者/編者, 訳者, 版表示, 出版地, 出版者, 出版年, 総ページ/冊数, シリーズ, ISBN)
\DeclareBibliographyDriver{book}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\usebibmacro{editor}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{translator}%
  \setunit{\addperiod\space}\newblock
  \printfield{edition}%
  \setunit*{\addcomma\space}%
  \usebibmacro{publisher+location+date}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:pagetotal+volumes}%
  \setunit*{\addcomma\space}%
  \usebibmacro{series+number}%
  \setunit*{\addcomma\space}%
  \printfield{isbn}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.2.2 図書の１章・一部 / 5.2.3 論文集の１論文
\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{sist:booktitle}%
  \setunit{\addperiod\space}%
  \usebibmacro{editor}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{translator}%
  \setunit{\addperiod\space}\newblock
  \printfield{edition}%
  \setunit*{\addcomma\space}%
  \usebibmacro{publisher+location+date}%
  \setunit*{\addcomma\space}%
  \printfield{pages}%
  \setunit*{\addcomma\space}%
  \usebibmacro{series+number}%
  \setunit*{\addcomma\space}%
  \printfield{isbn}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.5.1 会議報告全体
\DeclareBibliographyDriver{proceedings}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}{}{\usebibmacro{author}\setunit{\labelnamepunct}\newblock}%
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{editor}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{event+venue+date}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{publisher+location+date}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:pagetotal+volumes}%
  \setunit*{\addcomma\space}%
  \usebibmacro{series+number}%
  \setunit*{\addcomma\space}%
  \printfield{isbn}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.5.2 / 5.5.3 会議報告・予稿集・要旨集の１論文 (雑誌掲載予稿 4.2.4(3) 対応含む)
\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \iffieldundef{booktitle}
    {\printfield{eventtitle}}
    {\usebibmacro{sist:booktitle}}%
  \setunit{\addperiod\space}%
  \usebibmacro{editor}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{event+venue+date}%
  \setunit{\addperiod\space}\newblock
  \iffieldundef{journaltitle}
    {\usebibmacro{publisher+location+date}%
     \setunit*{\addcomma\space}%
     \printfield{pages}%
     \setunit*{\addcomma\space}%
     \usebibmacro{series+number}%
     \setunit*{\addcomma\space}%
     \printfield{isbn}%
     \setunit*{\addcomma\space}%
     \printfield{doi}}
    {\usebibmacro{journal+issuetitle}%
     \printfield{pages}%
     \setunit*{\addcomma\space}%
     \printfield{doi}}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.3 レポート (5.3.1 レポート１冊 / 5.3.2 レポート中の１論文: booktitle の有無で自動切替)
\DeclareBibliographyDriver{report}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \iffieldundef{booktitle}
    {\usebibmacro{title}%
     \setunit{\addperiod\space}\newblock}
    {\usebibmacro{sist:quotedtitle}%
     \setunit{\addperiod\space}\newblock
     \usebibmacro{sist:booktitle}%
     \setunit{\addperiod\space}%
     \usebibmacro{editor}%
     \setunit{\addperiod\space}\newblock}%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \iflistundef{publisher}
    {\printlist{institution}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \setunit*{\addcomma\space}%
  \iffieldundef{number}
    {\printfield{isrn}}
    {\printfield{number}}%
  \setunit*{\addcomma\space}%
  \iffieldundef{booktitle}
    {\usebibmacro{sist:pagetotal+volumes}}
    {\printfield{pages}}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.4 学位論文
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \printlist{institution}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \setunit*{\addcomma\space}%
  \printfield{pagetotal}%
  \setunit*{\addcomma\space}%
  \printfield{type}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.6 プレプリント (および 5.9 例3: プレプリント公開中の投稿論文)
\DeclareBibliographyDriver{unpublished}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \iflistundef{publisher}
    {\iflistundef{organization}
       {\iffieldundef{eprinttype}{}{\printfield{eprinttype}}}
       {\printlist{organization}}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \setunit*{\addcomma\space}%
  \iffieldundef{number}
    {\printfield{eprint}}
    {\printfield{number}}%
  \setunit*{\addcomma\space}%
  \printfield{pagetotal}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \iffieldundef{pubstate}
    {}
    {\setunit{\addperiod\space}\newblock
     \usebibmacro{sist:pubstate}}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.7 特許文献 (特許出願人 holder. 発明者 author. 発明の名称. 特許番号. 発行日付.)
\DeclareBibliographyDriver{patent}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{holder}
    {}
    {\printnames{holder}\clearname{holder}\setunit{\labelnamepunct}\newblock}%
  \ifnameundef{author}
    {}
    {\usebibmacro{author}\setunit{\labelnamepunct}\newblock}%
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \iffieldundef{type}
    {}
    {\printfield{type}\setunit{\addspace}}%
  \printfield{number}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{sist:date}%
  \iffieldundef{pubstate}
    {}
    {\setunit{\addperiod\space}\newblock
     \usebibmacro{sist:pubstate}}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.8 規格文書 (規格番号：制定年. 規格標題. 出版者.)
\DeclareBibliographyDriver{standard}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {}
    {\usebibmacro{author}\setunit{\labelnamepunct}\newblock}%
  \iffieldundef{number}
    {}
    {\printfield{number}%
     \iffieldundef{year}
       {}
       {\savefield{number}{\sist@stdnum}%
        \savefield{year}{\sist@stdyr}%
        \sist@ifcontains{\sist@stdnum}{\sist@stdyr}
          {}
          {\setunit{}\printtext{:}\printfield{year}}}%
     \setunit{\addperiod\space}\newblock}%
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \iflistundef{publisher}
    {\printlist{organization}}
    {\printlist{publisher}}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.10 ウェブサイト, ウェブページ, ブログ
\DeclareBibliographyDriver{online}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\ifnameundef{editor}{}{\usebibmacro{editor}}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \iflistundef{organization}
    {\iflistundef{publisher}
       {\usebibmacro{sist:booktitle}}
       {\printlist{publisher}}}
    {\printlist{organization}}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{sist:updatedate}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.11 メーリングリスト, 電子掲示板
\DeclareBibliographyDriver{letter}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{sist:quotedtitle}%
  \setunit{\addperiod\space}\newblock
  \iflistundef{organization}
    {\usebibmacro{sist:booktitle}}
    {\printlist{organization}}%
  \setunit{\addperiod\space}\newblock
  \usebibmacro{sist:updatedate}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.12 データベース (5.12.1 全体 / 5.12.2 一部: booktitle/maintitle 有無で切替)
\DeclareBibliographyDriver{dataset}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\ifnameundef{editor}{}{\usebibmacro{editor}}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \ifboolexpr{
    not test {\iffieldundef{booktitle}} or
    not test {\iffieldundef{maintitle}}
  }
    {\usebibmacro{sist:quotedtitle}%
     \setunit{\addperiod\space}\newblock
     \iffieldundef{booktitle}
       {\printfield{maintitle}}
       {\usebibmacro{sist:booktitle}}}
    {\usebibmacro{title}}%
  \setunit{\addperiod\space}\newblock
  \printfield{version}%
  \setunit*{\addcomma\space}%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \iflistundef{publisher}
    {\printlist{organization}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \iffieldundef{updateyear}
    {\usebibmacro{sist:date}}
    {\ifboolexpr{
       not test {\iffieldundef{year}} and not test {\iffieldsequal{year}{updateyear}}
     }
       {\usebibmacro{sist:date}\setunit*{\addcomma\space}\usebibmacro{sist:updatedate}}
       {\usebibmacro{sist:updatedate}}}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 5.13 コンピュータプログラム・ソースコード
\DeclareBibliographyDriver{software}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\ifnameundef{editor}{}{\usebibmacro{editor}}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \ifboolexpr{
    not test {\iffieldundef{booktitle}} or
    not test {\iffieldundef{maintitle}}
  }
    {\usebibmacro{sist:quotedtitle}%
     \setunit{\addperiod\space}\newblock
     \iffieldundef{booktitle}
       {\printfield{maintitle}}
       {\usebibmacro{sist:booktitle}}}
    {\usebibmacro{title}}%
  \setunit{\addperiod\space}\newblock
  \iffieldundef{version}
    {\printfield{commit}}
    {\printfield{version}%
     \iffieldundef{commit}
       {}
       {\setunit{\addspace}\printtext[parens]{\printfield{commit}}}}%
  \setunit*{\addcomma\space}%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \iflistundef{publisher}
    {\printlist{organization}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \iffieldundef{updateyear}
    {\usebibmacro{sist:date}}
    {\ifboolexpr{
       not test {\iffieldundef{year}} and not test {\iffieldsequal{year}{updateyear}}
     }
       {\usebibmacro{sist:date}\setunit*{\addcomma\space}\usebibmacro{sist:updatedate}}
       {\usebibmacro{sist:updatedate}}}%
  \setunit*{\addcomma\space}%
  \printfield{doi}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 法令・判例
\DeclareBibliographyDriver{legislation}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \printfield{number}%
  \setunit*{\addcomma\space}%
  \printlist{organization}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% 映像資料 (video / movie: namea フォールバック対応)
\DeclareBibliographyDriver{video}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\ifnameundef{namea}
       {\ifnameundef{editor}
          {}
          {\usebibmacro{editor}}}
       {\printnames{namea}}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \iflistundef{publisher}
    {\printlist{organization}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

% その他資料 (misc フォールバック)
\DeclareBibliographyDriver{misc}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \ifnameundef{author}
    {\ifnameundef{editor}{}{\usebibmacro{editor}}}
    {\usebibmacro{author}}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \setunit{\addperiod\space}\newblock
  \printfield{howpublished}%
  \setunit*{\addcomma\space}%
  \iflistundef{publisher}
    {\printlist{organization}}
    {\printlist{publisher}}%
  \setunit*{\addcomma\space}%
  \usebibmacro{sist:date}%
  \usebibmacro{sist:noteelements}%
  \usebibmacro{finentry}}

